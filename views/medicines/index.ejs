<%- include('../partials/header') %>

<div class="section-title">
  <div>
    <h2>My Medicines</h2>
    <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 4px;">Manage all your medicine schedules and dosages</p>
  </div>
  <a href="/medicines/add" class="btn btn-primary">
    <i class="ri-add-line"></i> Add New Medicine
  </a>
</div>

<% if (medicines.length === 0) { %>
  <div class="glass-panel">
    <div class="empty-state">
      <i class="ri-capsule-line"></i>
      <h3>No Medicines Found</h3>
      <p>You haven't added any medicines yet. Get started by adding your first medication.</p>
      <a href="/medicines/add" class="btn btn-primary">Add Medicine</a>
    </div>
  </div>
<% } else { %>
  <div class="medicine-list">
    <% medicines.forEach(function(medicine) { %>
      <div class="glass-panel medicine-item">
        <div class="med-left">
          <div class="med-status-indicator status-pending" title="Active"></div>
          <div class="med-info">
            <span class="med-name"><%= medicine.MedicineName %></span>
            <div class="med-meta">
              <span><i class="ri-drop-line"></i> Dosage: <strong><%= medicine.Dosage %></strong></span>
              <span><i class="ri-time-line"></i> Time: <strong><%= medicine.Time %></strong></span>
              <% 
                const shortDays = medicine.DaysOfWeek 
                  ? medicine.DaysOfWeek.split(',').map(d => d.substring(0, 3)).join(', ') 
                  : 'None';
              %>
              <span><i class="ri-calendar-check-line"></i> Days: <strong><%= shortDays %></strong></span>
              <span><i class="ri-music-2-line"></i> Ringtone: <strong><%= medicine.Ringtone %></strong></span>
            </div>
            <% if (medicine.Notes) { %>
              <div class="med-notes">
                <i class="ri-sticky-note-line"></i> Notes: <%= medicine.Notes %>
              </div>
            <% } %>
          </div>
        </div>
        
        <div class="med-actions">
          <a href="/medicines/edit/<%= medicine.MedicineId %>" class="btn btn-secondary btn-icon" title="Edit Medicine">
            <i class="ri-edit-2-line"></i>
          </a>
          <form action="/medicines/delete/<%= medicine.MedicineId %>" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this medicine? All logs in history associated with this medicine will also be deleted.');">
            <button type="submit" class="btn btn-danger btn-icon" title="Delete Medicine">
              <i class="ri-delete-bin-line"></i>
            </button>
          </form>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<%- include('../partials/footer') %>
